                  "minLength": 1,
                  "maxLength": 100
                },
                "maxItems": 50
              },
              "assignees": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,39}$"
                },
                "maxItems": 10
              },
              "milestone": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              }
            },
            "additionalProperties": false
