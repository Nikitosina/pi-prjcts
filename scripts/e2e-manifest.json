    "scripts/lib/**",
    "scripts/notify-kit.mjs",
    "scripts/run-e2e.mjs",
    "scripts/check-fast.mjs",
    "scripts/e2e-manifest.json",
    "scripts/fake-*.mjs",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "src/host.ts",
    "src/host-server.ts",
    "src/host-environment.ts",
    "src/state.ts",
    "src/http.ts",
    "src/client.ts",
    "src/cli.ts",
    "src/durable-runtime.ts",
    "src/durable-host.ts",
    "src/index.ts"
  ],
  "smoke": [
    "durable-runtime",
    "durable-knowledge",
    "coordinator-efficiency",
    "quota-status",
    "coordinator-gh",
    "machine-status-unit",
    "usage-limits-recovery-unit",
