{
  "name": "pi-projects-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "inbox": "node src/cli.ts ui",
    "e2e:durable-runtime": "node scripts/durable-runtime-e2e.mjs",
    "e2e:durable-host": "node scripts/durable-host-e2e.mjs",
    "e2e:durable-knowledge": "node scripts/durable-knowledge-e2e.mjs",
    "setup": "npm ci",
    "e2e:legacy-removal": "node scripts/legacy-removal-e2e.mjs",
    "e2e:coordinator-efficiency": "node scripts/coordinator-efficiency-e2e.mjs",
    "e2e:quota-status": "node scripts/quota-status-e2e.mjs",
    "e2e:coordinator-gh": "node scripts/coordinator-gh-e2e.mjs",
    "unit:machine-status": "node scripts/machine-status-unit.mjs",
    "unit:usage-limits-recovery": "node scripts/usage-limits-recovery-unit.mjs",
    "verify": "npm run check && npm run e2e:durable-runtime && npm run e2e:durable-knowledge && npm run e2e:coordinator-efficiency && npm run e2e:quota-status && npm run e2e:coordinator-gh && npm run unit:machine-status && npm run unit:usage-limits-recovery",
    "projects": "node src/cli.ts"
  },
  "pi": { "extensions": [] },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.2",
    "qrcode-generator": "2.0.4",
    "typebox": "1.3.27",
    "unpdf": "1.8.1"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-codemode": "1.0.2",
    "@earendil-works/pi-telemetry": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
