{
  "name": "pi-projects-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "inbox": "node src/cli.ts ui",
    "e2e:durable-runtime": "node scripts/durable-runtime-e2e.mjs",
    "e2e:durable-host": "node scripts/durable-host-e2e.mjs",
    "e2e:durable-knowledge": "node scripts/durable-knowledge-e2e.mjs",
    "setup": "node scripts/link-host.mjs && node scripts/link-durable.mjs",
    "link:durable": "node scripts/link-durable.mjs",
    "e2e:legacy-removal": "node scripts/legacy-removal-e2e.mjs",
    "projects": "node src/cli.ts"
  },
  "pi": { "extensions": ["src/extension.ts"] },
  "dependencies": { "@earendil-works/pi-durable": "1.0.0", "unpdf": "1.8.1" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
